# Required: Telegram bot token from @BotFather. Never put a real token in Git.
BOT_TOKEN=PASTE_TOKEN_FROM_BOTFATHER

# SQLite database path. Use persistent Pterodactyl storage.
DB_PATH=heradelegend.db

# INFO, WARNING, ERROR, or DEBUG. Avoid DEBUG in production unless troubleshooting.
LOG_LEVEL=INFO

# Optional: Telegram user ID of the service owner (numeric).
OWNER_TELEGRAM_ID=YOUR_TELEGRAM_USER_ID

# Optional: SOCKS5/HTTP proxy URL if the host cannot reach api.telegram.org directly.
# Do not commit proxy credentials. Leave empty to connect directly.
TELEGRAM_PROXY=

# Optional Telegram API request timeout in seconds.
TELEGRAM_REQUEST_TIMEOUT=60
